# sync-youtube-downloads.env: option strings inserted between URL and comment.
#
# Copy to sync-youtube-downloads.env (gitignored) next to the script, or to
# ~/.config/sync-youtube-downloads/, or point --env-file / $SYD_ENV_FILE at it.
#
# One key per profile: PROFILE_<NAME>, where <NAME> is the profile argument
# uppercased with dashes turned into underscores (music-videos -> PROFILE_MUSIC_VIDEOS).
# The value is everything after the first '=', taken literally: no quote
# removal and no $VAR expansion, so it can contain both ' and ".

PROFILE_MUSIC_VIDEOS=| --no-match-filters --match-filter title~='(?i)music video|official video' --match-filter "title!~='(?i)lyric video|visualizer|visualiser' & description~='(?i)music video|official video'"
